# Production setup
# 1. Copy this file to backend/.env on the server.
# 2. Replace every YOUR_* value before starting Docker.
# 3. Never commit backend/.env or paste its contents into GitHub Actions logs.

# ── Required: application security ──────────────────────────────────────────
# Generate a new value for a new installation:
#   openssl rand -hex 32
# Keep the existing value when reconnecting to an existing production database;
# changing it invalidates currently issued login tokens.
SECRET_KEY=YOUR_64_CHARACTER_HEX_SECRET

# Keep the existing key when reconnecting to an existing production database.
# Changing it prevents decryption of exchange API keys already stored in the DB.
# Generate only for a completely new environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_FERNET_KEY

# ── Required: PostgreSQL ─────────────────────────────────────────────────────
# Use the RDS endpoint or the hostname/IP of the PostgreSQL server.
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_NAME=YOUR_DB_NAME

# ── Kakao login ──────────────────────────────────────────────────────────────
# Register this exact redirect URI in the Kakao Developers console.
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_REDIRECT_URI=https://YOUR_DOMAIN/auth/kakao

# ── Browser access ───────────────────────────────────────────────────────────
# This must be a JSON array, not a comma-separated string.
CORS_ORIGINS=["https://YOUR_DOMAIN"]

# ── Optional: notifications ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: exchange defaults ──────────────────────────────────────────────
# Leave blank unless a server-level exchange account is required.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ── Optional: Korea Investment market data ───────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCESS_TOKEN=

# ── Optional: intraday scalping alerts ───────────────────────────────────────
SCALPING_ALERT_ENABLED=false
SCALPING_ALERT_DRY_RUN=true
SCALPING_ALERT_CHAT_ID=

# ── Optional: Toss Payments ──────────────────────────────────────────────────
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
